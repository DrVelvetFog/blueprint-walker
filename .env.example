# Copy to .env for local development (gitignored). Never commit the real key.
#
# Local vision backend choice (server-side only — never read by the browser):
#   anthropic  -> Claude. Needs ANTHROPIC_API_KEY. What the deployed site uses.
#   ollama     -> local Ollama, only reachable when running `netlify dev` on a
#                 machine running Ollama. The deployed cloud cannot reach it.
VISION_BACKEND=anthropic

# Required when VISION_BACKEND=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Optional, only for the ollama backend
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5vl:7b
